@PACKAGE_INIT@

# ---------------------------------------------------------------------------
# meta-auth-core package configuration.
#
# The imported target `meta_auth::meta_auth` carries the dialect options the
# library was built with (contracts, reflection, hardening). This file only
# has to verify that the consumer's compiler can honour them: a build that
# silently dropped `-freflection` would still link, but the compile-time
# guarantees the consumer wrote code against would be gone.
# ---------------------------------------------------------------------------
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/meta-auth-core-targets.cmake")

set(META_AUTH_CORE_VERSION "@PROJECT_VERSION@")

check_required_components(meta-auth-core)
